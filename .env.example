# ===========================================
# Pebiss - Environment Variables for Production
# ===========================================
# Copy this file to .env and fill in your values
# In Coolify, set these as Environment Variables
# ===========================================

# ---- DATABASE ----
# SQLite database path (inside container)
DATABASE_URL=file:/app/data/pebiss.db

# ---- UPLOADS ----
# Directory for uploaded files (must be on a persistent volume)
UPLOADS_DIR=/app/uploads

# ---- NEXTAUTH ----
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret-key
# Your production URL (e.g., https://pebiss.yourdomain.com)
NEXTAUTH_URL=http://localhost:3000

# ---- ADMIN USER (created on first startup) ----
# Default admin credentials - change these!
ADMIN_EMAIL=admin@pebiss.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrateur Pebiss
ADMIN_PHONE=

# ---- SERVER ----
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
